<?xml version="1.0" encoding="utf-8"?>
<!--
  Natvis definitions for LuaJIT 2.1 using 64-bit GC references.
-->
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <Type Name="lua_State">
    <Expand>
      <Synthetic Name="[stack]">
        <DisplayString>{top - ((TValue *)stack.ptr64 + 1)} total slots</DisplayString>
        <Expand>
          <CustomListItems>
            <Variable Name="_frame" InitialValue="base-1" />
            <Variable Name="_nextframe" InitialValue="base-1" />
            <Variable Name="_idx" InitialValue="0" />
            <Variable Name="_size" InitialValue="0" />
            <Loop Condition="_frame &gt; (TValue *)stack.ptr64 + 1">
              <If Condition="(GCobj *)((_frame-1)-&gt;gcr.gcptr64 &amp; 0x7fffffffffffull) != (GCobj *)this">
                <If Condition="(_frame-&gt;ftsz &amp; 7) != 3">
                  <If Condition="_idx == 0">
                    <Exec>_size = (int)(top - _frame - 1)</Exec>
                  </If>
                  <If Condition="_idx != 0">
                    <Exec>_size = (int)(_nextframe - _frame - 2)</Exec>
                  </If>
                  <Item Name="[{_idx}] [frame]">(TValue *)(_frame+1),[_size]</Item>
                  <Item Name="[{_idx}] [link] (lua)" Condition="(_frame-&gt;ftsz &amp; 3) == 0">(GCfunc *)((_frame-1)-&gt;gcr.gcptr64 &amp; 0x7fffffffffffull)</Item>
                  <Item Name="[{_idx}] [link] (c)" Condition="(_frame-&gt;ftsz &amp; 7) == 1">(GCfunc *)((_frame-1)-&gt;gcr.gcptr64 &amp; 0x7fffffffffffull)</Item>
                  <Item Name="[{_idx}] [link] (continuation)" Condition="(_frame-&gt;ftsz &amp; 7) == 2">(GCfunc *)((_frame-1)-&gt;gcr.gcptr64 &amp; 0x7fffffffffffull)</Item>
                  <Item Name="[{_idx}] [link] (cpcall)" Condition="(_frame-&gt;ftsz &amp; 7) == 5">(GCfunc *)((_frame-1)-&gt;gcr.gcptr64 &amp; 0x7fffffffffffull)</Item>
                  <Item Name="[{_idx}] [link] (ff pcall)" Condition="(_frame-&gt;ftsz &amp; 7) == 6">(GCfunc *)((_frame-1)-&gt;gcr.gcptr64 &amp; 0x7fffffffffffull)</Item>
                  <Item Name="[{_idx}] [link] (ff pcall w/ hook)" Condition="(_frame-&gt;ftsz &amp; 7) == 7">(GCfunc *)((_frame-1)-&gt;gcr.gcptr64 &amp; 0x7fffffffffffull)</Item>
                  <Exec>_idx++</Exec>
                </If>
              </If>
              <Exec>_nextframe = _frame</Exec>
              <If Condition="(_frame-&gt;ftsz &amp; 3) == 0">
                <Exec>_frame = _frame - (2 + ((((uint32_t *)(intptr_t)_frame-&gt;ftsz)[-1]) &gt;&gt; 8) &amp; 0xff)</Exec>
              </If>
              <Else>
                <Exec>_frame = (TValue *)((char *)_frame - (_frame-&gt;ftsz &amp; ~7))</Exec>
              </Else>
            </Loop>
          </CustomListItems>
        </Expand>
      </Synthetic>
      <Item Name="[environment]">((GCobj *)env.gcptr64)-&gt;tab</Item>
      <Item Name="[global state]">(global_State *)glref.ptr64</Item>
    </Expand>
  </Type>

  <Type Name="TValue">
    <DisplayString Condition="(uint32_t)(it64 >> 47) == (~0u)">(nil)</DisplayString>
    <DisplayString Condition="(uint32_t)(it64 >> 47) == (~1u)">(boolean) false</DisplayString>
    <DisplayString Condition="(uint32_t)(it64 >> 47) == (~2u)">(boolean) true</DisplayString>
    <DisplayString Condition="(uint32_t)(it64 >> 47) == (~3u)">(lightud) {(void *)((gcr.gcptr64 &amp; 0x7fffffffffffull))}</DisplayString>
    <DisplayString Condition="(uint32_t)(it64 >> 47) == (~4u)">(string) {((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;str}</DisplayString>
    <DisplayString Condition="(uint32_t)(it64 >> 47) == (~5u)">(upval) {((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;uv}</DisplayString>
    <DisplayString Condition="(uint32_t)(it64 >> 47) == (~6u)">(thread) {((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;th}</DisplayString>
    <DisplayString Condition="(uint32_t)(it64 >> 47) == (~7u)">(proto) {((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;pt}</DisplayString>
    <DisplayString Condition="(uint32_t)(it64 >> 47) == (~8u)">(function) {((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;fn}</DisplayString>
    <DisplayString Condition="(uint32_t)(it64 >> 47) == (~11u)">(table) {((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;tab}</DisplayString>
    <DisplayString Condition="(uint32_t)(it64 >> 47) == (~12u)">(udata) {((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;ud}</DisplayString>
    <DisplayString Condition="(uint32_t)(it64 >> 47) &lt;= (~13u)">(number) {n,g}</DisplayString>
    <DisplayString>[unknown tag {(it64 &gt;&gt; 47),x} {(it64 &gt;&gt; 47) == (~0ull)}] {u64,x}</DisplayString>
    <Expand>
      <Item Name="[lightud]" Condition="(it64 >> 47) == (~3u)">(luaFS_lightuserdata *)(u64 &amp; 0x7fffffffffffull)</Item>
      <Item Name="[string]" Condition="it == (~4u)">((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;str</Item>
      <Item Name="[upval]" Condition="it == (~5u)">((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;uv</Item>
      <Item Name="[thread]" Condition="it == (~6u)">((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;th</Item>
      <Item Name="[proto]" Condition="it == (~7u)">((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;pt</Item>
      <Item Name="[function]" Condition="it == (~8u)">((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;fn</Item>
      <Item Name="[table]" Condition="it == (~11u)">((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;tab</Item>
      <Item Name="[udata]" Condition="it == (~12u)">((GCobj *)(gcr.gcptr64 &amp; 0x7fffffffffffull))-&gt;ud</Item>
    </Expand>
  </Type>

  <Type Name="GCstr">
    <DisplayString>{(GCstr *)&amp;nextgc + 1,s8}</DisplayString>
    <StringView>(const char *)((GCstr *)&amp;nextgc + 1)</StringView>
    <Expand>
      <Synthetic Name="[raw data]" Condition="len != 0">
        <DisplayString>{(GCstr *)&amp;nextgc + 1,[len]}</DisplayString>
        <StringView>(const char *)((GCstr *)&amp;nextgc + 1),[len]</StringView>
      </Synthetic>
    </Expand>
 </Type>

  <Type Name="GCtab">
    <DisplayString>{{array={asize,d} hash={hmask != 0 ? hmask+1 : 0,d} metatable={metatable.gcptr64 != 0}}}</DisplayString>
    <Expand>
      <Synthetic Name="[array]" Condition="asize != 0">
        <DisplayString Condition="colo &gt; 0">{asize} slots (colocated)</DisplayString>
        <DisplayString Condition="colo &lt; 0">{asize} slots (detached)</DisplayString>
        <DisplayString>{asize} slots</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>asize</Size>
            <ValuePointer>(TValue *)array.ptr64</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="[hash]" Condition="hmask != 0">
        <DisplayString>{hmask + 1} slots</DisplayString>
        <Expand>
          <CustomListItems>
            <Variable Name="_ptr" InitialValue="(Node *)node.ptr64" />
            <Variable Name="_idx" InitialValue="0" />
            <Loop Condition="_idx &lt;= hmask">
              <Exec>_ptr = (Node *)node.ptr64 + _idx</Exec>
              <If Condition="_ptr-&gt;val.it != (~0u)">
                <Item Name="[{_idx}] {_ptr->key}">_ptr,na</Item>
              </If>
              <Exec>_idx++</Exec>
            </Loop>
          </CustomListItems>
        </Expand>
      </Synthetic>
      <Item Name="[metatable]" Condition="metatable.gcptr64 != 0">((GCobj *)metatable.gcptr64)-&gt;tab</Item>
    </Expand>
  </Type>

  <Type Name="GCudata">
    <Expand>
      <Item Name="[metatable]" Condition="metatable.gcptr64 != 0">((GCobj *)metatable.gcptr64)-&gt;tab</Item>
    </Expand>
  </Type>

  <Type Name="GCfunc">
    <DisplayString Condition="c.ffid == 0">(lua function) {l}</DisplayString>
    <DisplayString Condition="c.ffid == 1">(c function) {c}</DisplayString>
    <DisplayString Condition="c.ffid &gt; 1">(builtin function) {(int)c.ffid}</DisplayString>
    <Expand>
      <Item Name="[lua function]" Condition="c.ffid == 0">l</Item>
      <Item Name="[c function]" Condition="c.ffid == 1">c</Item>
    </Expand>
  </Type>

  <Type Name="GCfuncL">
    <DisplayString>{(GCproto *)(pc.ptr64 - sizeof(GCproto))}</DisplayString>
    <Expand>
      <Item Name="[proto]">(GCproto *)((char*)pc.ptr64 - sizeof(GCproto))</Item>
      <Synthetic Name="[upvalues]" Condition="nupvalues != 0">
        <DisplayString>{(int)nupvalues} upvalues</DisplayString>
        <Expand>
          <IndexListItems>
            <Size>nupvalues</Size>
            <ValueNode>(GCupval *)uvptr[$i].gcptr64,na</ValueNode>
          </IndexListItems>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <Type Name="GCfuncC">
    <DisplayString>{f,na}</DisplayString>
    <Expand>
      <Item Name="[function]">f</Item>
      <Synthetic Name="[upvalues]" Condition="nupvalues != 0">
        <DisplayString>{(int)nupvalues} upvalues</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>nupvalues</Size>
            <ValuePointer>upvalue</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <Type Name="GCproto">
    <DisplayString>{(chunkname.gcptr64 + sizeof(GCstr)),s8b}:{firstline}</DisplayString>
    <Expand>
      <Synthetic Name="[bytecode]">
        <DisplayString>{sizebc} operations</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>sizebc</Size>
            <ValuePointer>(uint32_t *)((GCproto *)&amp;nextgc + 1),x</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <Type Name="GCupval">
    <DisplayString>{(TValue *)v.ptr64}</DisplayString>
    <Expand>
      <Item Name="[value]">(TValue *)v.ptr64</Item>
      <Item Name="[closed]">closed != 0</Item>
    </Expand>
  </Type>

  <Type Name="FrameLink">
    <DisplayString Condition="(ftsz &amp; 2) == 0">(lua)</DisplayString>
    <DisplayString Condition="(ftsz &amp; 3) == 1">(c)</DisplayString>
    <DisplayString Condition="(ftsz &amp; 3) == 2">(continuation)</DisplayString>
    <DisplayString Condition="(ftsz &amp; 3) == 3">(lua vararg)</DisplayString>
    <DisplayString Condition="(ftsz &amp; 3) == 5">(cpcall)</DisplayString>
    <DisplayString Condition="(ftsz &amp; 3) == 6">(ff pcall)</DisplayString>
    <DisplayString Condition="(ftsz &amp; 3) == 7">(ff pcall w/ hook)</DisplayString>
    <Expand>
      <Item Name="[function]">(GCfunc *)((_frame-1)-&gt;gcr.gcptr64 &amp; 0x7fffffffffffull)</Item>
      <Item Name="[pc]" Condition="(ftsz &amp; 2) == 0u">(BCIns *)pcr.ptr64</Item>
      <!--<Item Name="[slots]">(TValue *)(this+1),[ftsz &amp; ~3]</Item>-->
    </Expand>
  </Type>

</AutoVisualizer>
